.settings-page { padding-bottom: calc(208rpx + env(safe-area-inset-bottom)); }
.settings-page.has-error { padding-bottom: calc(336rpx + env(safe-area-inset-bottom)); }
.status { padding: 80rpx 32rpx; text-align: center; }
.document-heading { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 32rpx 16rpx; background: #fff; }
.file-symbol { flex: 0 0 44rpx; width: 44rpx; }
.heading-copy { flex: 1; min-width: 0; width: 0; }
.name { font-size: 28rpx; font-weight: 600; word-break: break-all; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.muted { margin-top: 6rpx; font-size: 24rpx; }
.replacement-status { padding: 20rpx 32rpx; background: #fff; }
.replacement-error { margin: 0; padding: 20rpx 32rpx; font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.printer-line { display: flex; align-items: center; gap: 12rpx; padding: 0 32rpx 20rpx; background: #fff; color: #626c70; font-size: 24rpx; }
.printer-line > text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.form { background: #fff; padding: 0 32rpx; }
.row { min-height: 88rpx; display: flex; justify-content: space-between; align-items: center; gap: 24rpx; border-bottom: 2rpx solid #edf0f1; font-size: 28rpx; }
.label { flex: 0 0 128rpx; width: 128rpx; }
picker { min-width: 0; flex: 1; }
.choice { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; padding: 20rpx 0; line-height: 1.5; }
.choice > text { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.segments { display: flex; align-items: center; justify-content: flex-end; gap: 4rpx; min-width: 0; flex: 1; padding: 8rpx 0; flex-wrap: wrap; }
.segment { width: auto; min-width: 112rpx; margin: 0; padding: 0 20rpx; height: 60rpx; line-height: 60rpx; font-size: 26rpx; border-radius: 6rpx; background: #f0f3f3; color: #626c70; font-weight: 400; }
.segment::after { border: 0; }
.segment.selected { background: #e0f2ed; color: #06655c; font-weight: 600; }
.stepper { display: flex; align-items: center; gap: 8rpx; flex: 0 0 auto; }
.stepper input, .scale input { width: 88rpx; height: 56rpx; text-align: center; border: 2rpx solid #d8dfe0; border-radius: 6rpx; font-size: 28rpx; }
.range { flex: 1; min-width: 0; text-align: right; height: 72rpx; font-size: 26rpx; }
.scale { display: flex; gap: 12rpx; align-items: center; }
.section-toggle { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 20rpx 32rpx; background: #fff; text-align: left; line-height: 1.5; border-radius: 0; font-size: 28rpx; border-bottom: 2rpx solid #e1e6e7; font-weight: 500; }
.section-toggle::after { border: 0; }
.toggle-summary { flex: 1; min-width: 0; color: #818c90; font-size: 24rpx; font-weight: 400; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.advanced { border-top: 2rpx solid #edf0f1; }
.option-note { color: #915d27; font-size: 24rpx; padding: 12rpx 0; }
.reload-section { margin-top: 16rpx; padding: 24rpx 32rpx; background: #fff; }
.section-title { font-weight: 600; font-size: 28rpx; }
.preview-section { padding: 20rpx 24rpx 0; background: #e9edef; }
.preview-stage { height: 320rpx; max-height: 30vh; min-height: 200rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.page-image { width: 100%; height: 100%; display: block; }
.preview-empty { text-align: center; font-size: 24rpx; line-height: 1.6; color: #626c70; }
.page-toolbar { display: flex; align-items: center; justify-content: center; position: relative; gap: 16rpx; height: 80rpx; }
.page-counter { min-width: 160rpx; text-align: center; font-size: 24rpx; }
.zoom-action { position: absolute; right: 0; top: 8rpx; }
.action-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid #d8dfe0; }
.action-summary { color: #626c70; font-size: 24rpx; margin-bottom: 12rpx; text-align: center; }
.action-error { display: flex; align-items: center; gap: 12rpx; max-height: 128rpx; overflow-y: auto; font-size: 24rpx; padding: 12rpx 16rpx; margin-bottom: 12rpx; }
.action-error > text { flex: 1; min-width: 0; }
