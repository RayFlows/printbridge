.device-heading { display: flex; align-items: center; gap: 16rpx; }
.heading-copy { flex: 1; min-width: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0 16rpx; font-size: 24rpx; border-bottom: 2rpx solid #dde2e3; padding-bottom: 12rpx; }
.action-error { margin-bottom: 24rpx; }
.status-region { padding: 56rpx 0; }
.empty { text-align: center; }
.empty-title { font-weight: 600; margin: 24rpx 0 12rpx; font-size: 32rpx; }
.retry { margin-top: 32rpx; }
.printer { background: #fff; border: 2rpx solid #e0e5e6; border-radius: 12rpx; margin-bottom: 24rpx; overflow: hidden; }
.printer-heading { display: flex; align-items: center; gap: 24rpx; width: 100%; padding: 28rpx 24rpx; text-align: left; line-height: 1.5; background: #fff; border-radius: 0; }
.printer-symbol { color: #087f73; flex-shrink: 0; width: 52rpx; }
.printer-summary { flex: 1; min-width: 0; width: 0; }
.printer-name { font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; word-break: normal; }
.printer-id { color: #7b8589; font-size: 24rpx; overflow-wrap: anywhere; word-break: break-all; margin-top: 4rpx; }
.printer-state { display: flex; align-items: center; margin-top: 12rpx; font-size: 24rpx; color: #626c70; }
.state-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #90999d; margin-right: 12rpx; flex-shrink: 0; }
.state-idle { color: #087f73; }
.state-idle .state-dot { background: #087f73; }
.state-processing { color: #3c69b2; }
.state-processing .state-dot { background: #3c69b2; }
.state-stopped { color: #ae4c23; }
.state-stopped .state-dot { background: #bf5e2f; }
.state-disconnected { color: #ae4c23; }
.state-disconnected .state-dot { background: #bf5e2f; }
.reason { color: #9c4327; background: #fff5eb; font-size: 24rpx; padding: 16rpx 24rpx; word-break: break-all; }
.select-action { padding: 8rpx 24rpx 24rpx; }
.current-task { border-top: 2rpx solid #edf0f1; padding: 24rpx; }
.task-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; font-size: 24rpx; color: #6d777b; flex-wrap: wrap; }
.task-state { color: #087f73; }
.task-name { font-size: 28rpx; line-height: 1.6; margin-top: 12rpx; overflow-wrap: anywhere; word-break: break-all; }
.task-meta { font-size: 24rpx; color: #6d777b; margin-top: 8rpx; }
.state-note { font-size: 24rpx; line-height: 1.7; padding: 12rpx 0; }
