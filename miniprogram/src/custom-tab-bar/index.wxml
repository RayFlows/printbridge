<view class="tab-dock">
  <view class="tab-capsule">
    <view class="tab-track" aria-role="tablist" aria-label="主导航"
      bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
      <view class="tab-indicator {{dragging ? 'tab-indicator-dragging' : ''}}" style="transform:translateX({{position * 100}}%);" aria-hidden="true"></view>
      <button wx:for="{{tabs}}" wx:key="pagePath" class="tab-item {{preview === index ? 'tab-item-active' : ''}}"
        aria-role="tab" aria-label="{{item.text}}" aria-selected="{{selected === index}}" hover-class="none"
        data-index="{{index}}" bindtap="onTap">
        <image class="tab-icon" src="{{preview === index ? item.selectedIcon : item.icon}}" mode="aspectFit" aria-hidden="true" />
        <text class="tab-label">{{item.text}}</text>
      </button>
    </view>
  </view>
</view>
