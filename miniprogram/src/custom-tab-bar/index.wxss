:host { pointer-events: none; }
.tab-dock {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  padding: 0 32rpx calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}
.tab-capsule {
  box-sizing: border-box;
  width: 400rpx;
  max-width: 100%;
  height: 116rpx;
  padding: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 32rpx rgba(32, 38, 40, 0.12), 0 0 0 2rpx rgba(32, 38, 40, 0.04);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  pointer-events: auto;
}
.tab-track { position: relative; display: flex; width: 100%; height: 100%; }
.tab-indicator {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 50%;
  border-radius: 999rpx;
  background: #e4f1ed;
  pointer-events: none;
  transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.tab-indicator-dragging { transition: none; }
.tab-item {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #697579;
  font-family: inherit;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: 0;
}
.tab-item::after { border: 0; }
.tab-item-active { color: #087f73; font-weight: 600; }
.tab-icon { display: block; width: 44rpx; height: 44rpx; flex-shrink: 0; pointer-events: none; }
.tab-label { display: block; margin-top: 4rpx; white-space: nowrap; pointer-events: none; }
