page {
  background: #f5f6f7;
  color: #202628;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
  --td-brand-color: #087f73;
  --td-brand-color-active: #06655c;
  --td-button-border-radius: 12rpx;
  --td-radius-default: 12rpx;
}

view, text, button, input { box-sizing: border-box; }
.page { padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.tab-page { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.muted { color: #6d777b; }
.error { background: #fff0ef; color: #a13227; padding: 24rpx; border-left: 6rpx solid #c84b3d; line-height: 1.6; overflow-wrap: anywhere; }
.title { font-size: 38rpx; font-weight: 600; line-height: 1.4; }
.breakable { word-break: break-all; }
