.reload-guide { padding-top: 16rpx; color: #293438; letter-spacing: 0; }
.steps { display: flex; gap: 12rpx; }
.step { flex: 1; min-width: 0; text-align: center; }
.drawing { display: block; width: 100%; height: 192rpx; }
.step-title { font-size: 26rpx; line-height: 1.5; padding-top: 8rpx; overflow-wrap: anywhere; }
.edge-legend { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; font-size: 24rpx; line-height: 1.6; color: #626c70; }
.edge-mark { width: 24rpx; height: 6rpx; background: #b64d73; flex-shrink: 0; }
.direction { font-size: 28rpx; line-height: 1.7; margin-top: 24rpx; }
.reminder { color: #626c70; font-size: 26rpx; line-height: 1.7; margin-top: 8rpx; }
